const SHEET_ID='PASTE_GOOGLE_SHEET_ID';const ROOT_FOLDER_ID='PASTE_GOOGLE_DRIVE_FOLDER_ID';const SUBMIT_MIN=15,HUNT_MIN=30;
function doGet(){return out({ok:true,name:'Office Photo Hunt API'})}function doPost(e){try{const q=JSON.parse(e.postData.contents||'{}'),fn=ACTIONS[q.action];if(!fn)throw Error('Unknown action');return out({ok:true,...fn(q)})}catch(err){return out({ok:false,error:String(err.message||err)})}}function out(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
function ss(){return SpreadsheetApp.openById(SHEET_ID)}function sh(n,heads){let s=ss().getSheetByName(n)||ss().insertSheet(n);if(s.getLastRow()===0)s.appendRow(heads);return s}function id(n=12){const c='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';return Array.from({length:n},()=>c[Math.floor(Math.random()*c.length)]).join('')}function rows(n,h){let s=sh(n,h),v=s.getDataRange().getValues(),head=v.shift();return v.map((r,i)=>Object.fromEntries(head.map((x,j)=>[x,r[j]])))}function append(n,h,r){sh(n,h).appendRow(h.map(x=>r[x]??''))}function now(){return Date.now()}function lock(fn){let l=LockService.getScriptLock();l.waitLock(20000);try{return fn()}finally{l.releaseLock()}}
const H={Games:['gameId','gameCode','createdAt','submitEndsAt','huntEndsAt','status','folderId'],Teams:['gameId','teamId','teamCode','teamName','createdAt'],Players:['gameId','teamId','playerId','nickname','token','joinedAt'],Photos:['gameId','photoId','ownerTeamId','slot','fileId','url','createdAt'],Assignments:['gameId','teamId','slot','photoId','sourceTeamId'],Scores:['gameId','teamId','photoId','bestScore','attempts','updatedAt']};
function getGame(q){let g=rows('Games',H.Games).find(x=>x.gameId===q.gameId);if(!g)throw Error('Game not found');return g}function auth(q){let p=rows('Players',H.Players).find(x=>x.gameId===q.gameId&&x.playerId===q.playerId&&x.teamId===q.teamId&&x.token===q.token);if(!p)throw Error('Session expired');return p}function phase(g){let t=now();return t<+g.submitEndsAt?'SUBMIT':t<+g.huntEndsAt?'HUNT':'FINISHED'}
function createGame(q){return lock(()=>{if(!q.nickname||!q.teamName)throw Error('Name and team name required');let t=now(),gameId=id(),gameCode=id(6),folder=DriveApp.getFolderById(ROOT_FOLDER_ID).createFolder('Game_'+gameCode),teamId=id(),teamCode=id(6),playerId=id(),token=id(24);append('Games',H.Games,{gameId,gameCode,createdAt:t,submitEndsAt:t+SUBMIT_MIN*60000,huntEndsAt:t+(SUBMIT_MIN+HUNT_MIN)*60000,status:'ACTIVE',folderId:folder.getId()});append('Teams',H.Teams,{gameId,teamId,teamCode,teamName:q.teamName.trim(),createdAt:t});append('Players',H.Players,{gameId,teamId,playerId,nickname:q.nickname.trim(),token,joinedAt:t});return{session:{gameId,gameCode,teamId,teamCode,teamName:q.teamName.trim(),playerId,token}}})}
function joinGame(q){return lock(()=>{let g=rows('Games',H.Games).find(x=>x.gameCode===String(q.gameCode||'').toUpperCase());if(!g)throw Error('Invalid game code');if(phase(g)!=='SUBMIT')throw Error('Joining has closed');let teams=rows('Teams',H.Teams).filter(x=>x.gameId===g.gameId),team=q.teamCode?teams.find(x=>x.teamCode===q.teamCode):null;if(q.teamCode&&!team)throw Error('Invalid team code');if(!team){if(!q.teamName)throw Error('Enter a new team name');team={gameId:g.gameId,teamId:id(),teamCode:id(6),teamName:q.teamName.trim(),createdAt:now()};append('Teams',H.Teams,team)}let count=rows('Players',H.Players).filter(x=>x.gameId===g.gameId&&x.teamId===team.teamId).length;if(count>=5)throw Error('This team already has 5 players');let playerId=id(),token=id(24);append('Players',H.Players,{gameId:g.gameId,teamId:team.teamId,playerId,nickname:String(q.nickname||'').trim(),token,joinedAt:now()});return{session:{gameId:g.gameId,gameCode:g.gameCode,teamId:team.teamId,teamCode:team.teamCode,teamName:team.teamName,playerId,token}}})}
function uploadPhoto(q){auth(q);let g=getGame(q);if(phase(g)!=='SUBMIT')throw Error('Photo submission has ended');let slot=+q.slot;if(slot<1||slot>5)throw Error('Invalid slot');let photos=rows('Photos',H.Photos),old=photos.find(x=>x.gameId===q.gameId&&x.ownerTeamId===q.teamId&&+x.slot===slot);if(old)try{DriveApp.getFileById(old.fileId).setTrashed(true)}catch(e){}let bytes=Utilities.base64Decode(q.data),blob=Utilities.newBlob(bytes,q.mime||'image/jpeg','photo.jpg'),folder=DriveApp.getFolderById(g.folderId),file=folder.createFile(blob),photoId=old?old.photoId:id(),url='https://drive.google.com/uc?export=view&id='+file.getId();if(old)updateWhere('Photos',H.Photos,r=>r.gameId===q.gameId&&r.photoId===photoId,{fileId:file.getId(),url,createdAt:now()});else append('Photos',H.Photos,{gameId:q.gameId,photoId,ownerTeamId:q.teamId,slot,fileId:file.getId(),url,createdAt:now()});file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);return{photoId,url}}
function ensureAssignments(g){return lock(()=>{let all=rows('Assignments',H.Assignments).filter(x=>x.gameId===g.gameId);if(all.length)return;let teams=rows('Teams',H.Teams).filter(x=>x.gameId===g.gameId),photos=rows('Photos',H.Photos).filter(x=>x.gameId===g.gameId);teams.forEach(t=>{let pool=photos.filter(p=>p.ownerTeamId!==t.teamId).sort(()=>Math.random()-.5);if(pool.length<5)return;pool.slice(0,5).forEach((p,i)=>append('Assignments',H.Assignments,{gameId:g.gameId,teamId:t.teamId,slot:i+1,photoId:p.photoId,sourceTeamId:p.ownerTeamId}))})})}
function state(q){auth(q);let g=getGame(q),ph=phase(g);if(ph!=='SUBMIT')ensureAssignments(g);let teams=rows('Teams',H.Teams).filter(x=>x.gameId===q.gameId),team=teams.find(x=>x.teamId===q.teamId),players=rows('Players',H.Players).filter(x=>x.gameId===q.gameId&&x.teamId===q.teamId),photos=rows('Photos',H.Photos).filter(x=>x.gameId===q.gameId),as=rows('Assignments',H.Assignments).filter(x=>x.gameId===q.gameId&&x.teamId===q.teamId),scores=rows('Scores',H.Scores).filter(x=>x.gameId===q.gameId&&x.teamId===q.teamId),targets=as.map(a=>photos.find(p=>p.photoId===a.photoId)).filter(Boolean),allScores=rows('Scores',H.Scores).filter(x=>x.gameId===q.gameId),leaderboard=teams.map(t=>({teamName:t.teamName,total:allScores.filter(s=>s.teamId===t.teamId).reduce((a,s)=>a+(+s.bestScore||0),0),updated:Math.max(0,...allScores.filter(s=>s.teamId===t.teamId).map(s=>+s.updatedAt||0))})).sort((a,b)=>b.total-a.total||a.updated-b.updated);return{game:{gameCode:g.gameCode,phase:ph,submitEndsAt:+g.submitEndsAt,huntEndsAt:+g.huntEndsAt,serverOffset:now()-Date.now(),teamName:team.teamName,teamCode:team.teamCode,members:players.map(x=>({nickname:x.nickname})),myPhotos:photos.filter(x=>x.ownerTeamId===q.teamId),targets:targets.map(x=>({photoId:x.photoId,url:x.url})),scores:Object.fromEntries(scores.map(x=>[x.photoId,x])),leaderboard}}}
function saveScore(q){auth(q);let g=getGame(q);if(phase(g)!=='HUNT')throw Error('Scoring is not open');let assigned=rows('Assignments',H.Assignments).some(x=>x.gameId===q.gameId&&x.teamId===q.teamId&&x.photoId===q.photoId);if(!assigned)throw Error('Target not assigned');let score=Math.max(0,Math.min(100,Math.round(+q.score||0))),old=rows('Scores',H.Scores).find(x=>x.gameId===q.gameId&&x.teamId===q.teamId&&x.photoId===q.photoId);if(old)updateWhere('Scores',H.Scores,r=>r.gameId===q.gameId&&r.teamId===q.teamId&&r.photoId===q.photoId,{bestScore:Math.max(+old.bestScore,score),attempts:+old.attempts+1,updatedAt:now()});else append('Scores',H.Scores,{gameId:q.gameId,teamId:q.teamId,photoId:q.photoId,bestScore:score,attempts:1,updatedAt:now()});return{score}}
function updateWhere(n,h,p,changes){let s=sh(n,h),v=s.getDataRange().getValues();for(let i=1;i<v.length;i++){let r=Object.fromEntries(h.map((x,j)=>[x,v[i][j]]));if(p(r)){h.forEach((x,j)=>{if(x in changes)s.getRange(i+1,j+1).setValue(changes[x])});break}}}
function cleanupExpiredGames(){let cutoff=now()-24*3600000;rows('Games',H.Games).filter(g=>+g.huntEndsAt<cutoff&&g.status!=='DELETED').forEach(g=>{try{DriveApp.getFolderById(g.folderId).setTrashed(true)}catch(e){}updateWhere('Games',H.Games,r=>r.gameId===g.gameId,{status:'DELETED'})})}
const ACTIONS={createGame,joinGame,uploadPhoto,state,saveScore};